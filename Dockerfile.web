# Parts 2 + 3: the Navigator web app in one container. The React UI is built in a Node stage and served by the
# FastAPI backend (server.py mounts web/dist after its /api routes).
# Mounted at run time (see docker-compose.yml, service "web"): the challenge package and the lakehouse (read-only),
# and a volume for outputs/ (drafts, conversations, audit log).

FROM node:22-slim AS ui
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    CCN_ROOT=/package \
    LAKEHOUSE_DIR=/app/lakehouse

WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt

COPY server.py answer_e.py GLOSSARY.md ./
COPY copilot/ copilot/
COPY pipeline/ pipeline/
COPY docs/adr/ docs/adr/
COPY --from=ui /web/dist web/dist

RUN useradd --create-home ccn && mkdir -p outputs lakehouse && chown -R ccn /app
USER ccn

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
