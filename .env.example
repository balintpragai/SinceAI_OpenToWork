# Copy to .env (git-ignored) and fill in.
# Where the unzipped challenge package lives on the host (mounted read-only into the pipeline container).
CCN_PACKAGE_DIR=./.tmp/Apetit_SinceAI2026/APETIT_CLIMATE_NATURE_NAVIGATOR_2026/APETIT_CLIMATE_NATURE_NAVIGATOR_2026
# Enables embeddings for the document index (gemini-embedding-001). Leave empty to index without vectors.
GEMINI_API_KEY=
# Host port for the Azurite blob endpoint (container port is 10000).
LAKEHOUSE_PORT=10010
